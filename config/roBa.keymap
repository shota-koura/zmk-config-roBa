#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <2>;
    scroll-layers = <4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1 2>;
        };

        Hankaku_Zenkaku {
            bindings = <&kp LANG_ZENKAKUHANKAKU>;
            key-positions = <1 0>;
        };

        Tab {
            bindings = <&to_layer_0 TAB>;
            key-positions = <11 10>;
        };

        Hankaku_katakana {
            bindings = <&kp F8>;
            key-positions = <5 6>;
        };

        Zenkaku_alphabet {
            bindings = <&kp F9>;
            key-positions = <6 7>;
        };

        Hankaku_alhabet {
            bindings = <&kp F10>;
            key-positions = <8 7>;
        };

        forth_layer {
            bindings = <&mo 4>;
            key-positions = <20 21>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <9 8 7>;
        };

        PageUp {
            bindings = <&kp PAGE_UP>;
            key-positions = <19 18>;
        };

        PageDown {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_scroll: encoder_msc_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W         &kp E         &kp R  &kp T                                             &kp Y             &kp U  &kp I      &kp O    &kp P
&kp A           &kp S         &kp D         &kp F  &kp G      &none                 &kp BACKSPACE    &kp H             &kp J  &kp K      &kp L    &kp ENTER
&kp Z           &kp X         &kp C         &kp V  &kp B      &kp INT_MUHENKAN      &kp RIGHT_SHIFT  &kp N             &kp M  &kp COMMA  &kp DOT  &kp MINUS
&kp LEFT_SHIFT  &kp LEFT_WIN  &kp LEFT_ALT  &mo 2  &kp SPACE  &mo 1                 &mo 3            &kp LEFT_CONTROL                             &kp QUESTION
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        NUM {
            bindings = <
&none   &none   &none   &none   &none                                &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH
&none   &none   &none   &none   &none   &none       &kp BACKSPACE    &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER
&trans  &trans  &trans  &trans  &none   &none       &kp RIGHT_SHIFT  &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans           &trans                                                  &kp PLUS
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        ARROWandMOUSE {
            bindings = <
&none   &kp F2              &none               &none                &none                                &none   &none           &none           &none            &none
&none   &none               &kp LG(UP_ARROW)    &none                &none   &none       &kp BACKSPACE    &none   &mkp LCLK       &kp UP_ARROW    &mkp RCLK        &mo 5
&none   &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &none   &none       &kp RIGHT_SHIFT  &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&trans  &trans              &trans              &trans               &trans  &trans      &trans           &trans                                                   &kp F5
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        SYMBOL {
            bindings = <
&kp EXCLAMATION       &kp HASH                 &kp PERIOD         &kp COMMA            &kp LS(EQUAL)                                         &kp RIGHT_BRACKET  &kp BACKSLASH     &kp LS(NUMBER_8)       &kp LS(NUMBER_9)   &kp LEFT_BRACKET
&kp LS(SEMICOLON)     &kp MINUS                &kp DOUBLE_QUOTES  &kp SLASH            &kp LS(MINUS)            &none       &kp BACKSPACE    &kp LESS_THAN      &kp GREATER_THAN  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp ENTER
&kp LS(LEFT_BRACKET)  &kp LS(INTERNATIONAL_3)  &kp DOLLAR         &kp INTERNATIONAL_3  &kp LS(INTERNATIONAL_1)  &none       &kp RIGHT_SHIFT  &kp LS(NUMBER_7)   &kp LS(NUMBER_2)  &kp SINGLE_QUOTE       &kp SEMICOLON      &kp MINUS
&trans                &trans                   &trans             &trans               &trans                   &trans      &trans           &trans                                                                         &trans
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        Snipe {
            bindings = <
&none   &kp F2              &none               &none                &none                                &none      &none           &kp RS(LG(S))   &kp LC(W)        &mo 4
&none   &none               &kp LG(UP_ARROW)    &none                &none   &none       &kp BACKSPACE    &kp LC(C)  &mkp LCLK       &kp UP_ARROW    &mkp RCLK        &kp ENTER
&none   &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &none   &none       &kp RIGHT_SHIFT  &kp LC(V)  &kp DOWN_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp MINUS
&trans  &trans              &trans              &trans               &trans  &trans      &trans           &trans                                                      &kp F5
            >;

            sensor-bindings = <&encoder_msc_scroll>;
        };

        Tentative {
            bindings = <
&kp EXCLAMATION  &kp HASH   &kp PERIOD    &kp COMMA             &kp TILDE                                    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN
&kp PLUS         &kp MINUS  &kp ASTERISK  &kp SLASH             &kp EQUAL       &none       &kp BACKSPACE    &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER
&kp GRAVE        &kp PIPE   &kp DOLLAR    &kp NON_US_BACKSLASH  &kp UNDERSCORE  &none       &kp RIGHT_SHIFT  &kp SQT           &kp DOUBLE_QUOTES  &kp COLON             &kp SEMI               &kp MINUS
&trans           &trans     &trans        &trans                &trans          &trans      &trans           &trans                                                                            &kp QUESTION
            >;
        };
    };
};
