#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1 2>;
        };

        Hankaku_Zenkaku {
            bindings = <&kp LS(LANG_ZENKAKUHANKAKU)>;
            key-positions = <1 0>;
        };

        Tab {
            bindings = <&to_layer_0 TAB>;
            key-positions = <11 10>;
        };

        Hankaku_katakana {
            bindings = <&kp F8>;
            key-positions = <5 6>;
        };

        Zenkaku_alphabet {
            bindings = <&kp F9>;
            key-positions = <6 7>;
        };

        Hankaku_alhabet {
            bindings = <&kp F10>;
            key-positions = <8 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W         &kp E         &kp R  &kp T                                           &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A           &kp S         &kp D         &kp F  &kp G      &kp LS(LG(S))         &kp BACKSPACE  &kp H      &kp J  &kp K      &kp L    &kp ENTER
&kp Z           &kp X         &kp C         &kp V  &kp B      &kp INT_MUHENKAN      &kp DELETE     &kp N      &kp M  &kp COMMA  &kp DOT  &kp QUESTION
&kp LEFT_SHIFT  &kp LEFT_WIN  &kp LEFT_ALT  &mo 2  &kp SPACE  &mo 1                 &mo 3          &kp RCTRL                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        NUM {
            bindings = <
&none   &none   &none   &none   &none                              &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH
&none   &none   &none   &none   &none   &none       &kp BACKSPACE  &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ENTER
&trans  &trans  &trans  &trans  &none   &none       &kp DELETE     &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans         &trans                                                  &kp PLUS
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        ARROWandMOUSE {
            bindings = <
&none   &kp F2          &none           &none            &none                              &kp RC(W)  &mkp MB4        &kp LS(LG(S))   &mkp MB5         &kp F5
&none   &none           &kp UP_ARROW    &none            &none   &none       &kp BACKSPACE  &kp RC(C)  &mkp LCLK       &kp UP_ARROW    &mkp RCLK        &kp ENTER
&none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &none       &kp DELETE     &kp RC(V)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&trans  &trans          &trans          &trans           &trans  &trans      &trans         &trans                                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        SYMBOL {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH   &kp DOLLAR    &kp PERCENT                             &kp SINGLE_QUOTE  &kp MINUS          &kp LCTRL             &kp NON_US_BACKSLASH   &kp AT_SIGN
&kp SEMICOLON    &kp COLON          &kp SLASH  &kp ASTERISK  &none        &none       &kp BACKSPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ENTER
&none            &none              &none      &none         &none        &none       &kp DELETE     &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACE        &kp RIGHT_BRACE        &none
&trans           &trans             &trans     &trans        &trans       &trans      &trans         &trans                                                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN C_AC_SCROLL_UP>;
        };
    };
};
